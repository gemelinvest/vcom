rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidPhoneNumber(phoneNumber) {
      return phoneNumber is string
        && phoneNumber.matches('^020[0-9]{6}$');
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isApproved(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.approved == true;
    }

    function canClearInCall() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inCall', 'activeCallId'])
        && request.resource.data.inCall == false
        && request.resource.data.activeCallId == null
        && resource.data.activeCallId is string
        && exists(/databases/$(database)/documents/calls/$(resource.data.activeCallId))
        && (
          get(/databases/$(database)/documents/calls/$(resource.data.activeCallId)).data.callerId == request.auth.uid
          || get(/databases/$(database)/documents/calls/$(resource.data.activeCallId)).data.calleeId == request.auth.uid
        );
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'phoneNumber', 'createdAt', 'approved'])
        && request.resource.data.approved == false
        && isValidPhoneNumber(request.resource.data.phoneNumber);
      allow update: if request.auth != null && (
        isAdmin()
        || canClearInCall()
        || (
          request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved', 'lineActive'])
        )
      );
      allow delete: if isAdmin();
    }

    match /phoneNumbers/{phoneNumber} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && isValidPhoneNumber(phoneNumber)
        && (
          request.resource.data.userId == request.auth.uid
          || (isAdmin() && request.resource.data.userId == "retired" && request.resource.data.retired == true)
        );
      allow update: if isAdmin()
        && request.resource.data.userId == "retired"
        && request.resource.data.retired == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'retired']);
      allow delete: if false;
    }

    match /users/{userId}/contacts/{contactId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'phoneNumber', 'createdAt'])
        && isValidPhoneNumber(request.resource.data.phoneNumber);
    }

    match /calls/{callId} {
      allow read: if request.auth != null
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid
            || (resource.data.participantIds != null
                && request.auth.uid in resource.data.participantIds));
      allow create: if request.auth != null
        && request.resource.data.callerId == request.auth.uid
        && isApproved(request.auth.uid)
        && isApproved(request.resource.data.calleeId);
      allow update: if request.auth != null
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid
            || (resource.data.participantIds != null
                && request.auth.uid in resource.data.participantIds));
      allow delete: if request.auth != null
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid)
        && resource.data.status in ["ended", "rejected"];

      match /candidates/{candidateId} {
        allow read, create: if request.auth != null;
        allow delete: if request.auth != null
          && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
          );
      }

      match /mesh/{pairId} {
        allow read, create, update: if request.auth != null;
      }
    }

    match /guestLinks/{code} {
      function sameLink() {
        return request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ownerPhone == resource.data.ownerPhone
          && request.resource.data.ownerName == resource.data.ownerName
          && request.resource.data.guestName == resource.data.guestName
          && request.resource.data.tempPhone == resource.data.tempPhone
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt;
      }
      function linkLive() {
        return resource.data.status == "active"
          || resource.data.expiresAt > request.time.toMillis();
      }

      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && isApproved(request.auth.uid)
        && code == request.resource.data.code
        && code.matches('^[A-Za-z0-9]{6,12}$')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "waiting"
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() > 0
        && request.resource.data.guestName.size() < 40
        && request.resource.data.ownerName is string
        && request.resource.data.ownerPhone is string
        && request.resource.data.tempPhone is string
        && isValidPhoneNumber(request.resource.data.tempPhone)
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis() + 480000
        && request.resource.data.expiresAt < request.time.toMillis() + 720000
        && request.resource.data.offer == null
        && request.resource.data.answer == null
        && request.resource.data.callerCandidates is list
        && request.resource.data.callerCandidates.size() == 0
        && request.resource.data.guestCandidates is list
        && request.resource.data.guestCandidates.size() == 0;
      allow update: if sameLink() && (
        (
          request.auth != null
          && request.auth.uid == resource.data.ownerId
          && (
            linkLive()
            || resource.data.status == "ringing"
            || request.resource.data.status == "ended"
          )
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'guestCandidates', 'status', 'callStartedAt'])
          && request.resource.data.status in ["ringing", "active", "ended"]
          && (
            linkLive()
            || (
              resource.data.status == "ringing"
              && resource.data.expiresAt + 180000 > request.time.toMillis()
            )
          )
        )
      );
      allow delete: if false;
    }

    match /guestPhones/{phoneNumber} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && isApproved(request.auth.uid)
        && isValidPhoneNumber(phoneNumber)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Za-z0-9]{6,12}$')
        && request.resource.data.expiresAt is int;
      allow update, delete: if false;
    }

    match /app/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /chats/{chatId} {
      allow get: if request.auth != null && (
        resource == null
        || request.auth.uid in resource.data.participantIds
      );
      allow list, update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
